#!/usr/bin/env python
import os
import sys

env = SConscript("thirdparty/godot-cpp/SConstruct")

env.Tool('compilation_db')
compilation_db = env.CompilationDatabase('compile_commands.json')
env.Alias('compiledb', compilation_db)

env["ML_SOURCES"]  = []
env["ONNX_SOURCES"] = []

# ── vcpkg integration ─────────────────────────────────────────────────────────
# SConstruct lives in src/; project root (where vcpkg.json is) is one level up.
_project_root = os.path.dirname(Dir("#").abspath)

_default_triplets = {
    "windows": "x64-windows-static",
    "linux":   "x64-linux",
    "macos":   "arm64-osx",
    "android": "arm64-android",
    "ios":     "arm64-ios",
}
vcpkg_triplet = ARGUMENTS.get(
    "vcpkg_triplet",
    _default_triplets.get(env["platform"], "x64-windows-static")
)

# Manifest-mode local install (preferred): vcpkg_installed/ next to vcpkg.json
_manifest_installed = os.path.join(_project_root, "vcpkg_installed", vcpkg_triplet)

# Classic-mode fallback: {VCPKG_ROOT}/installed/{triplet}
vcpkg_root = ARGUMENTS.get("vcpkg_root", os.environ.get("VCPKG_ROOT", ""))
_classic_installed = os.path.join(vcpkg_root, "installed", vcpkg_triplet) if vcpkg_root else ""

if os.path.isdir(_manifest_installed):
    vcpkg_installed = _manifest_installed
    print(f"[vcpkg] manifest mode — installed: {vcpkg_installed}")
elif _classic_installed and os.path.isdir(_classic_installed):
    vcpkg_installed = _classic_installed
    print(f"[vcpkg] classic mode — installed: {vcpkg_installed}")
else:
    vcpkg_installed = _manifest_installed  # not yet installed; path will be used once created
    print(f"[vcpkg] WARNING: packages not found at {vcpkg_installed}")
    print(f"[vcpkg]   Run: vcpkg install --triplet {vcpkg_triplet}")
    print(f"[vcpkg]   (from the project root: {_project_root})")

env["VCPKG_TRIPLET"]   = vcpkg_triplet
env["VCPKG_INSTALLED"] = vcpkg_installed

# Propagate vcpkg include/lib paths to all sub-scripts via the parent env.
# env_onnx and env_ml are clones, so they inherit these automatically.
if os.path.isdir(vcpkg_installed):
    env.Append(CPPPATH=[os.path.join(vcpkg_installed, "include")])
    env.Append(LIBPATH=[os.path.join(vcpkg_installed, "lib")])

# Thirdparty
SConscript("thirdparty/SCsub", exports="env")

# ML Runtime
SConscript("ml/SCsub", exports="env")

# Include paths + libs
env.Append(CPPPATH=env.get("ML_INCLUDE_PATHS", []))
env.Append(CPPPATH=env.get("ONNX_INCLUDE_PATHS", []))

if "ML_ENV" in env:
    env.Append(LIBS=env["ML_ENV"]["LIBS"])
    env.Append(LIBPATH=env["ML_ENV"].get("LIBPATH", []))

# Extension library
sources = (
    ["register_types.cpp"]
    + env.get("ML_SOURCES", [])
    + env.get("ONNX_SOURCES", [])
)

lib_base_name = "libml"
demo_bin = "../demo/addons/ml/bin/"

if env["platform"] == "macos":
    target_path = "{}{}.{}.{}.framework/{}".format(
        demo_bin, lib_base_name, env["platform"], env["target"], lib_base_name
    )
    library = env.SharedLibrary(target_path, source=sources)
elif env["platform"] == "ios":
    suffix      = ".simulator.a" if env["ios_simulator"] else ".a"
    target_path = "{}{}.{}.{}{}".format(
        demo_bin, lib_base_name, env["platform"], env["target"], suffix
    )
    library = env.StaticLibrary(target_path, source=sources)
else:
    target_path = "{}{}{}{}".format(
        demo_bin, lib_base_name, env["suffix"], env["SHLIBSUFFIX"]
    )
    library = env.SharedLibrary(target_path, source=sources)

Default(library)
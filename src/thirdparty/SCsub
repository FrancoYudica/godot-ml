# thirdparty/onnx/SCsub
import os
import glob

Import("env")

env_onnx = env.Clone()

onnx_dir = os.path.join(Dir(".").abspath, "onnx")
build_dir = os.path.join(onnx_dir, "build")

env_onnx.Append(CPPDEFINES=["ONNX_ML=0"])
env_onnx.Append(
    CPPPATH=[
        onnx_dir,
        onnx_dir + "/onnx",
    ]
)

# ── Protobuf compiler ─────────────────────────────────────────────────────────

vcpkg_installed = env.get("VCPKG_INSTALLED", "")
if vcpkg_installed:
    _ext = ".exe" if env["platform"] == "windows" else ""
    _candidate = os.path.join(vcpkg_installed, "tools", "protobuf", f"protoc{_ext}")
    protoc = f'"{_candidate}"' if os.path.isfile(_candidate) else "protoc"
else:
    protoc = "protoc"

print(f"[vcpkg] protoc: {protoc}")

# ── Protobuf generation ───────────────────────────────────────────────────────

proto_files = [
    onnx_dir + "/onnx/onnx-ml.proto",
    onnx_dir + "/onnx/onnx-data.proto",
]

generated_cc = []
for proto in proto_files:
    cc = proto.replace(".proto", ".pb.cc")
    hdr = proto.replace(".proto", ".pb.h")
    env_onnx.Command(
        [cc, hdr],
        proto,
        f"{protoc}"
        f" --cpp_out={onnx_dir}/onnx/"
        f" --proto_path={onnx_dir}/onnx/"
        f" --proto_path={onnx_dir}/"
        f" {proto}",
    )
    generated_cc.append(cc)

for i in range(1, len(generated_cc)):
    env_onnx.Depends(generated_cc[i], generated_cc[i - 1])

env["ONNX_SOURCES"] = [
    env_onnx.SharedObject(
        target=os.path.join(
            build_dir,
            os.path.relpath(src, onnx_dir).replace(os.sep, "_").replace(".cc", ""),
        ),
        source=src,
    )
    for src in generated_cc
]
env["ONNX_INCLUDE_PATHS"] = [onnx_dir, onnx_dir + "/onnx"]

# ── Link libraries ────────────────────────────────────────────────────────────

_vcpkg_lib = os.path.join(env.get("VCPKG_INSTALLED", ""), "lib")

# vcpkg static builds name the library 'libprotobuf.lib'; dynamic use 'protobuf.lib'.
_protobuf_lib = (
    "libprotobuf"
    if os.path.isfile(os.path.join(_vcpkg_lib, "libprotobuf.lib"))
    else "protobuf"
)


# Discover transitive protobuf deps from vcpkg (absl + utf8_range).
def _discover_libs(pattern_win, pattern_unix):
    if not (_vcpkg_lib and os.path.isdir(_vcpkg_lib)):
        return []
    if env["platform"] == "windows":
        return [
            os.path.splitext(os.path.basename(f))[0]
            for f in glob.glob(os.path.join(_vcpkg_lib, pattern_win))
        ]
    return [
        os.path.splitext(os.path.basename(f))[0][3:]  # strip 'lib' prefix
        for f in glob.glob(os.path.join(_vcpkg_lib, pattern_unix))
    ]


_absl_libs = _discover_libs("absl_*.lib", "libabsl_*.a")
_utf8_libs = _discover_libs("utf8_range*.lib", "libutf8_range*.a")

env["ONNX_LIBS"] = [_protobuf_lib] + _absl_libs + _utf8_libs
